# El panel ya fuerza HTTPS. Estos archivos no se sirven.
Options -Indexes -MultiViews
ErrorDocument 403 /assets/error.php
ErrorDocument 404 /assets/error.php
ErrorDocument 500 /assets/error.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Solo las páginas públicas pierden el .php. El resto sigue con su nombre.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^(/.*)?/index\.php$
    RewriteRule ^index\.php$ %1/ [R=301,L]

    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^(/.*)?/(catalogo|flyer|descarga|cuenta/(?:login|registro|compras|logout))\.php$
    RewriteRule ^(catalogo|flyer|descarga|cuenta/(?:login|registro|compras|logout))\.php$ %1/%2 [R=301,L,NC,QSA]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(catalogo|flyer|descarga|cuenta/(?:login|registro|compras|logout))/?$ $1.php [L]

    # Una carpeta sin portada no muestra el sitio ni el listado de archivos.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php !-f
    RewriteRule ^ - [F,L]
</IfModule>

<FilesMatch "^(project\.md|AGENTS\.md|CLAUDE\.md|config\.local\.php|config\.example\.php)$">
    Require all denied
</FilesMatch>
